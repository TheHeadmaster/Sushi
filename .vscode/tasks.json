{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build: compiler",
            "type": "process",
            "command": "dotnet",
            "args": [
                "build",
                "${workspaceFolder}/Compiler/Sushi.csproj",
                "--configuration",
                "Debug"
            ],
            "problemMatcher": "$msCompile",
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "generate: syntax",
            "type": "npm",
            "script": "generate:syntax",
            "path": ".",
            "problemMatcher": []
        },
        {
            "label": "watch: extension",
            "type": "npm",
            "script": "watch",
            "path": ".",
            "isBackground": true,
            "problemMatcher": "$tsc-watch",
            "dependsOn": "generate: syntax",
            "dependsOrder": "sequence",
            "presentation": {
                "reveal": "silent",
                "panel": "dedicated"
            }
        }
    ]
}