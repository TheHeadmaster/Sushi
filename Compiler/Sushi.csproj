<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
    	<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<LangVersion>preview</LangVersion>
		<AnalysisLevel>latest-all</AnalysisLevel>
        <Nullable>enable</Nullable>
		<VersionPrefix>0.2.0</VersionPrefix>
		<VersionSuffix>alpha</VersionSuffix>
        <ApplicationIcon>Sushi.ico</ApplicationIcon>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">$(NETCoreSdkRuntimeIdentifier)</RuntimeIdentifier>
    </PropertyGroup>
<ItemGroup>
        <Content Include="Sushi.ico" />
    </ItemGroup>
    <ItemGroup>
        <InternalsVisibleTo Include="Sushi.Testing" />
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="OmniSharp.Extensions.LanguageServer" Version="0.19.9" />
        <PackageReference Include="Sushi.NativeToolchain.LlvmMingw.WinX64" Version="20260616" GeneratePathProperty="true" Condition="'$(RuntimeIdentifier)' == 'win-x64'" />
        <PackageReference Include="Serilog" Version="4.4.0" />
        <PackageReference Include="Serilog.Formatting.Compact" Version="3.0.0" />
        <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
        <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
        <PackageReference Include="Tomlyn" Version="2.10.1" />
        <PackageReference Include="LLVMSharp.Interop" Version="22.1.8" />
        <PackageReference Include="libLLVM" Version="22.1.8" />
        <PackageReference Include="Markdig" Version="1.5.1" />
        <PackageReference Include="Microsoft.Extensions.FileSystemGlobbing" Version="10.0.12" />
    </ItemGroup>
<PropertyGroup Condition="'$(RuntimeIdentifier)' == 'win-x64'">
        <SushiLlvmMingwPackageRoot>$(PkgSushi_NativeToolchain_LlvmMingw_WinX64)\toolchain</SushiLlvmMingwPackageRoot>
    </PropertyGroup>
    <ItemGroup Condition="'$(RuntimeIdentifier)' == 'win-x64'">
        <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
            <_Parameter1>SushiNativeToolchainPackageRoot</_Parameter1>
            <_Parameter2>$(SushiLlvmMingwPackageRoot)</_Parameter2>
        </AssemblyAttribute>
    </ItemGroup>
    <Target Name="StageWindowsX64NativeToolchain" AfterTargets="Publish" Condition="'$(RuntimeIdentifier)' == 'win-x64'">
        <Error Condition="!Exists('$(SushiLlvmMingwPackageRoot)/bin/clang.exe')" Text="The restored LLVM-MinGW NuGet package is missing or incomplete at $(SushiLlvmMingwPackageRoot). Run dotnet restore and verify the pinned toolchain package." />
        <ItemGroup>
            <LlvmMingwPublishFile Include="$(SushiLlvmMingwPackageRoot)/**/*" />
        </ItemGroup>
        <Copy SourceFiles="@(LlvmMingwPublishFile)" DestinationFiles="@(LlvmMingwPublishFile->'$(PublishDir)toolchains/win-x64/llvm-mingw/%(RecursiveDir)%(Filename)%(Extension)')" />
    </Target>
</Project>