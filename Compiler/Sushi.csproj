<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
    	<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<LangVersion>preview</LangVersion>
		<AnalysisLevel>latest-all</AnalysisLevel>
        <Nullable>enable</Nullable>
		<VersionPrefix>0.2.0</VersionPrefix>
		<VersionSuffix>alpha</VersionSuffix>
        <ApplicationIcon>Sushi.ico</ApplicationIcon>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">$(NETCoreSdkRuntimeIdentifier)</RuntimeIdentifier>
        <SushiLlvmMingwRoot>$(MSBuildThisFileDirectory)..\.tools\llvm-mingw</SushiLlvmMingwRoot>
    </PropertyGroup>
    <ItemGroup>
        <Content Include="Sushi.ico" />
    </ItemGroup>
    <ItemGroup>
        <InternalsVisibleTo Include="Sushi.Testing" />
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="OmniSharp.Extensions.LanguageServer" Version="0.19.9" />
        <PackageReference Include="Serilog" Version="4.4.0" />
        <PackageReference Include="Serilog.Formatting.Compact" Version="3.0.0" />
        <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
        <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
        <PackageReference Include="Tomlyn" Version="2.10.1" />
        <PackageReference Include="LLVMSharp.Interop" Version="22.1.8" />
        <PackageReference Include="libLLVM" Version="22.1.8" />
        <PackageReference Include="Markdig" Version="1.5.1" />
        <PackageReference Include="Microsoft.Extensions.FileSystemGlobbing" Version="10.0.12" />
    </ItemGroup>
    <ItemGroup Condition="'$(RuntimeIdentifier)' == 'win-x64' and '$(IsPublishing)' != 'true'">
        <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
            <_Parameter1>SushiNativeToolchainDevelopmentRoot</_Parameter1>
            <_Parameter2>$(SushiLlvmMingwRoot)</_Parameter2>
        </AssemblyAttribute>
    </ItemGroup>
    <Target Name="RestoreVendoredWindowsX64Toolchain" BeforeTargets="PrepareForBuild" Condition="'$(RuntimeIdentifier)' == 'win-x64' and '$(DesignTimeBuild)' != 'true'">
        <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)..\tools\RestoreVendoredLlvmMingw.ps1&quot; -DestinationRoot &quot;$(SushiLlvmMingwRoot)&quot;" />
    </Target>
    <Target Name="StageWindowsX64NativeToolchain" AfterTargets="Publish" Condition="'$(RuntimeIdentifier)' == 'win-x64'">
        <Error Condition="!Exists('$(SushiLlvmMingwRoot)/bin/clang.exe')" Text="The reconstructed LLVM-MinGW toolchain is missing at $(SushiLlvmMingwRoot). Run dotnet build to restore it from the checked-in chunks." />
        <ItemGroup>
            <LlvmMingwPublishFile Include="$(SushiLlvmMingwRoot)/**/*" />
        </ItemGroup>
        <Copy SourceFiles="@(LlvmMingwPublishFile)" DestinationFiles="@(LlvmMingwPublishFile->'$(PublishDir)toolchains/win-x64/llvm-mingw/%(RecursiveDir)%(Filename)%(Extension)')" />
    </Target>
</Project>
