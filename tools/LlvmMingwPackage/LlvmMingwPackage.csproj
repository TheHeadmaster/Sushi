<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <PackageId>Sushi.NativeToolchain.LlvmMingw.WinX64</PackageId>
        <Authors>TheHeadmaster</Authors>
        <PackageProjectUrl>https://github.com/mstorsjo/llvm-mingw</PackageProjectUrl>
        <RepositoryUrl>https://github.com/TheHeadmaster/Sushi</RepositoryUrl>
        <Description>Complete pinned LLVM-MinGW UCRT x64 toolchain for Sushi's Windows GNU native backend.</Description>
        <PackageTags>llvm;clang;lld;mingw;ucrt;windows-x64;sushi</PackageTags>
        <PackageLicenseFile>THIRD-PARTY-NOTICES.md</PackageLicenseFile>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
        <IncludeBuildOutput>false</IncludeBuildOutput>
        <IsPackable>true</IsPackable>
        <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    </PropertyGroup>
    <ItemGroup Condition="'$(LlvmMingwRoot)' != ''">
        <None Include="$(LlvmMingwRoot)/**/*" Pack="true" PackagePath="contentFiles/any/any/toolchain/%(RecursiveDir)%(Filename)%(Extension)" />
    </ItemGroup>
    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="README.md" />
        <None Include="THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="THIRD-PARTY-NOTICES.md" />
    </ItemGroup>
    <Target Name="ValidateLlvmMingwPackageInput" BeforeTargets="Pack">
        <Error Condition="'$(LlvmMingwRoot)' == ''" Text="Set LlvmMingwRoot to the verified extracted LLVM-MinGW root before packing." />
        <Error Condition="!Exists('$(LlvmMingwRoot)/bin/clang.exe')" Text="The package input does not contain bin/clang.exe." />
        <Error Condition="!Exists('$(LlvmMingwRoot)/bin/ld.lld.exe')" Text="The package input does not contain bin/ld.lld.exe." />
        <Error Condition="!Exists('$(LlvmMingwRoot)/x86_64-w64-mingw32/lib/crt2.o')" Text="The package input does not contain the Windows x64 GNU startup object." />
    </Target>
</Project>
